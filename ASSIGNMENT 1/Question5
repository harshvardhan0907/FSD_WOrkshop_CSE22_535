const express = require('express');

const app = express();


app.get('/', (req, res) => {

    res.send(`
        <h1>Welcome to Sweet Bakery!</h1>
        <p>Welcome to our bakery website.</p>

        <a href="/menu">Menu</a>
        <br>
        <a href="/contact">Contact</a>
    `);

});

// Menu Page
app.get('/menu', (req, res) => {

    res.send(`
        <h1>Our Bakery Menu</h1>

        <ul>
            <li>Chocolate Cake</li>
            <li>Black Forest Cake</li>
            <li>Pastries</li>
            <li>Cookies</li>
            <li>Bread</li>
        </ul>

        <a href="/">Home</a>
    `);

});


app.get('/contact', (req, res) => {

    res.send(`
        <h1>Contact Us</h1>

        <p>Phone: 9876543210</p>
        <p>Address: Ghaziabad, Uttar Pradesh</p>

        <a href="/">Home</a>
    `);

});


app.listen(3000, () => {
    console.log("Bakery website running at http://localhost:3000");
});